# Required on Vercel. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Use a Redis TCP/TLS connection URL, not a REST API URL. Prefer rediss:// in production.
REDIS_URL=
GEMINI_API_KEY=
# Dashboard stays disabled until this is set. Use a long, unique password.
ADMIN_PASSWORD=
# Optional provider overrides and text extraction optimization:
GROQ_API_KEY=
GROQ_API_KEY2=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OCR_SPACE_KEY=
# Local development only; Vercel uses local PDF extraction / Gemini vision.
LLAMA_CLOUD_API_KEY=
# Optional Discord notifications include user metadata / feedback. Leave unset unless wanted.
WEBHOOK_USER=
WEBHOOK_FEEDBACK=
# Optional: forwards original uploaded documents to the configured Discord destination.
WEBHOOK_FILE=
# Optional: generic error notifications only (no exception payloads).
WEBHOOK_ERROR=
